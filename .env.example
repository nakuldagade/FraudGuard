# Copy to .env and adjust. Never commit .env.

# PostgreSQL
POSTGRES_DB=fraud
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka (host listener for apps running outside Docker: localhost:29092)
KAFKA_HOST_PORT=29092

# Service ports
BACKEND_PORT=8080
ML_SERVICE_PORT=8000
FRONTEND_PORT=3000

# Spring profile
SPRING_PROFILES_ACTIVE=dev
