# Copy to .env and adjust. Never commit .env.

# PostgreSQL
POSTGRES_DB=fraud
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka (host listener for apps running outside Docker: localhost:29092)
KAFKA_HOST_PORT=29092

# Service ports
BACKEND_PORT=8080
ML_SERVICE_PORT=8000
FRONTEND_PORT=8081

# Spring profile
SPRING_PROFILES_ACTIVE=local

# ---------------------------------------------------------------------------------------------
# Security (Phase 10.4). LOCAL DEMO VALUES ONLY: change every one of these before sharing a deployment.
# Load into your shell before starting the backend / ML service:   set -a; source .env; set +a
# ---------------------------------------------------------------------------------------------
ENV=local                                   # the ML service refuses to start without tokens when this is not "local"

# Backend login tokens (JWT). At least 32 characters. Leave empty on the local profile for a random one
# (then tokens stop working whenever the backend restarts).
FRAUDGUARD_JWT_SECRET=local-demo-jwt-secret-change-me-0123456789

# Service API key(s) for POST /api/transactions (comma-separated). The seed script sends INGEST_API_KEY.
FRAUDGUARD_INGEST_API_KEYS=demo-ingest-key
INGEST_API_KEY=demo-ingest-key

# /actuator/** (Prometheus logs in with this)
FRAUDGUARD_METRICS_USERNAME=prometheus
FRAUDGUARD_METRICS_PASSWORD=demo-metrics-password

# First dashboard users, created only when the users table is empty
FRAUDGUARD_ADMIN_USERNAME=admin
FRAUDGUARD_ADMIN_PASSWORD=demo-admin-password
FRAUDGUARD_ANALYST_USERNAME=analyst
FRAUDGUARD_ANALYST_PASSWORD=demo-analyst-password
FRAUDGUARD_SEED_USERNAME=demo-oracle        # the demo labeller used by "npm run seed -- --label"
FRAUDGUARD_SEED_PASSWORD=demo-oracle-password
SEED_USERNAME=demo-oracle                   # the seed script logs in with these
SEED_PASSWORD=demo-oracle-password

# ML service <-> backend shared secrets
SERVICE_TOKEN=demo-service-token            # backend -> ML /score
ADMIN_TOKEN=demo-admin-token                # operators -> ML /admin/*

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Sign-in page: show the demo accounts (username and password) with one-click login. DEMO ONLY: the values are compiled into
# the frontend, so set this to false for anything other than a local demo (then rebuild the frontend image).
SHOW_DEMO_LOGINS=true
