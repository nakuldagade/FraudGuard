      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fraudguard_decisions_total{status=\"BLOCKED\"}[$__range])) / sum(increase(fraudguard_decisions_total[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Share of decisions that were BLOCKED. Synthetic demo data: the number says nothing about real fraud.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
